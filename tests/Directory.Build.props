<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>
  <ItemGroup>
    <PackageReference Include="Nullean.VsTest.Pretty.TestLogger" PrivateAssets="All" />
    <!-- all assets: from 3.0 it also self-registers as a Microsoft.Testing.Platform extension in the xUnit v3
         executable, and that generated registration needs the compile assets -->
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="All" />
  </ItemGroup>
</Project>
